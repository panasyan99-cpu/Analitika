# НЕ заменяйте этим файлом существующие Streamlit Secrets.
# Скопируйте нужные блоки и добавьте их в существующий TOML-документ:
# Streamlit Cloud → Settings → Secrets.

[auth]
operator_email = "<OPERATOR_EMAIL>"
operator_password = "<OPERATOR_PASSWORD>"
# Общий пароль для входа на сайт. Настоящее значение хранится только в Secrets.
password = "<APP_PASSWORD>"

[order_storage]
endpoint_url = "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
access_key_id = "<ACCESS_KEY_ID>"
secret_access_key = "<SECRET_ACCESS_KEY>"
bucket = "analitika-orders"
region = "auto"
prefix = "princess/analitika/supplier-orders"
required = true


[baserow]
email = "<BASEROW_EMAIL>"
password = "<BASEROW_PASSWORD>"
url = "https://storage.princess-jewelry.com"
token = "<BASEROW_DATABASE_TOKEN>"
database_id = 148
souvenirs_table_id = 642
components_table_id = 643
operations_table_id = 644
supplies_table_id = 645
# ID можно оставить 0: сайт обнаружит или создаст таблицу автоматически.
supply_lines_table_id = 0
# Email/пароль используются только сервером для короткого JWT и не показываются в интерфейсе.
