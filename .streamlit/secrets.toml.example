[auth]
password = "YOUR_SHARED_SITE_PASSWORD"

[baserow]
url = "https://storage.princess-jewelry.com"
token = "YOUR_DATABASE_TOKEN"
database_id = 148
souvenirs_table_id = 642
components_table_id = 643
operations_table_id = 644
supplies_table_id = 645
supply_lines_table_id = 646
email = "YOUR_BASEROW_EMAIL"
password = "YOUR_BASEROW_PASSWORD"

# Cloudflare R2 / S3-compatible persistent storage.
# Used for supplier-order workspaces, Sonu manual decisions and durable audit events.
[order_storage]
endpoint_url = "https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
access_key_id = "YOUR_R2_ACCESS_KEY_ID"
secret_access_key = "YOUR_R2_SECRET_ACCESS_KEY"
bucket = "analitika-orders"
region = "auto"
prefix = "princess/analitika"
required = true
